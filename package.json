{
  "name": "dsh-tui-vscode",
  "displayName": "dsh-tui (VS Code)",
  "description": "Run dsh-TUI in a real VS Code integrated terminal — an experience almost identical to the official Claude Code extension: Beside placement, multiple concurrent sessions, sidebar session history, one-click start/resume.",
  "version": "0.7.7",
  "publisher": "baobaolaodie",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/baobaolaodie/dsh-tui-vscode.git"
  },
  "engines": {
    "vscode": "^1.90.0"
  },
  "categories": [
    "AI",
    "Chat"
  ],
  "keywords": [
    "dsh",
    "dsh-tui",
    "deepseek-harness",
    "deepseek",
    "tui",
    "terminal",
    "claude-code-style"
  ],
  "main": "./out/extension.js",
  "l10n": "./l10n",
  "activationEvents": [
    "onStartupFinished",
    "onView:dsh-tui-vscode.sessions",
    "onView:dsh-tui-vscode.editReview"
  ],
  "contributes": {
    "viewsContainers": {
      "activitybar": [
        {
          "id": "dsh-tui-vscode",
          "title": "dsh-tui",
          "icon": "media/icon.svg"
        }
      ]
    },
    "views": {
      "dsh-tui-vscode": [
        {
          "id": "dsh-tui-vscode.sessions",
          "name": "%view.dsh-tui-vscode.sessions.name%"
        },
        {
          "id": "dsh-tui-vscode.editReview",
          "name": "%view.dsh-tui-vscode.editReview.name%"
        }
      ]
    },
    "viewsWelcome": [
      {
        "view": "dsh-tui-vscode.sessions",
        "contents": "%view.dsh-tui-vscode.sessions.welcome%"
      },
      {
        "view": "dsh-tui-vscode.editReview",
        "contents": "%view.dsh-tui-vscode.editReview.welcome%"
      }
    ],
    "menus": {
      "editor/title": [
        {
          "command": "dsh-tui-vscode.open",
          "group": "navigation"
        },
        {
          "command": "dsh-tui-vscode.editKeep",
          "when": "dshEditReview.activePending",
          "group": "navigation@2"
        },
        {
          "command": "dsh-tui-vscode.editUndo",
          "when": "dshEditReview.activePending",
          "group": "navigation@3"
        }
      ],
      "editor/context": [
        {
          "command": "dsh-tui-vscode.insertAtMention",
          "when": "editorTextFocus",
          "group": "navigation@2"
        },
        {
          "command": "dsh-tui-vscode.editKeepLine",
          "when": "dshEditReview.activePending && resourceScheme == file",
          "group": "dsh_review@1"
        },
        {
          "command": "dsh-tui-vscode.editUndoLine",
          "when": "dshEditReview.activePending && resourceScheme == file",
          "group": "dsh_review@2"
        }
      ],
      "view/item/context": [
        {
          "command": "dsh-tui-vscode.archiveSession",
          "when": "view == dsh-tui-vscode.sessions && viewItem == dshSession",
          "group": "inline@1"
        },
        {
          "command": "dsh-tui-vscode.renameSession",
          "when": "view == dsh-tui-vscode.sessions && viewItem == dshSession",
          "group": "inline@2"
        },
        {
          "command": "dsh-tui-vscode.deleteSession",
          "when": "view == dsh-tui-vscode.sessions && viewItem == dshSession",
          "group": "2_destructive@1"
        },
        {
          "command": "dsh-tui-vscode.editKeep",
          "when": "view == dsh-tui-vscode.editReview && viewItem == dshEdit",
          "group": "inline@1"
        },
        {
          "command": "dsh-tui-vscode.editUndo",
          "when": "view == dsh-tui-vscode.editReview && viewItem == dshEdit",
          "group": "inline@2"
        },
        {
          "command": "dsh-tui-vscode.editShowDiff",
          "when": "view == dsh-tui-vscode.editReview && viewItem == dshEdit",
          "group": "1_review@1"
        }
      ],
      "view/title": [
        {
          "command": "dsh-tui-vscode.editKeepAll",
          "when": "view == dsh-tui-vscode.editReview",
          "group": "navigation@1"
        },
        {
          "command": "dsh-tui-vscode.editUndoAll",
          "when": "view == dsh-tui-vscode.editReview",
          "group": "navigation@2"
        }
      ]
    },
    "commands": [
      {
        "command": "dsh-tui-vscode.open",
        "title": "%command.dsh-tui-vscode.open.title%",
        "category": "dsh-tui",
        "icon": "media/icon.svg"
      },
      {
        "command": "dsh-tui-vscode.start",
        "title": "%command.dsh-tui-vscode.start.title%",
        "category": "dsh-tui"
      },
      {
        "command": "dsh-tui-vscode.resume",
        "title": "%command.dsh-tui-vscode.resume.title%",
        "category": "dsh-tui"
      },
      {
        "command": "dsh-tui-vscode.focus",
        "title": "%command.dsh-tui-vscode.focus.title%",
        "category": "dsh-tui"
      },
      {
        "command": "dsh-tui-vscode.insertAtMention",
        "title": "%command.dsh-tui-vscode.insertAtMention.title%",
        "category": "dsh-tui"
      },
      {
        "command": "dsh-tui-vscode.kill",
        "title": "%command.dsh-tui-vscode.kill.title%",
        "category": "dsh-tui"
      },
      {
        "command": "dsh-tui-vscode.refreshSessions",
        "title": "%command.dsh-tui-vscode.refreshSessions.title%",
        "category": "dsh-tui",
        "icon": "$(refresh)"
      },
      {
        "command": "dsh-tui-vscode.resumeSession",
        "title": "%command.dsh-tui-vscode.resumeSession.title%",
        "category": "dsh-tui"
      },
      {
        "command": "dsh-tui-vscode.renameSession",
        "title": "%command.dsh-tui-vscode.renameSession.title%",
        "category": "dsh-tui",
        "icon": "$(edit)"
      },
      {
        "command": "dsh-tui-vscode.archiveSession",
        "title": "%command.dsh-tui-vscode.archiveSession.title%",
        "category": "dsh-tui",
        "icon": "$(archive)"
      },
      {
        "command": "dsh-tui-vscode.manageArchived",
        "title": "%command.dsh-tui-vscode.manageArchived.title%",
        "category": "dsh-tui",
        "icon": "$(archive)"
      },
      {
        "command": "dsh-tui-vscode.deleteSession",
        "title": "%command.dsh-tui-vscode.deleteSession.title%",
        "category": "dsh-tui",
        "icon": "$(trash)"
      },
      {
        "command": "dsh-tui-vscode.editKeep",
        "title": "%command.dsh-tui-vscode.editKeep.title%",
        "category": "dsh-tui",
        "icon": "$(check)"
      },
      {
        "command": "dsh-tui-vscode.editUndo",
        "title": "%command.dsh-tui-vscode.editUndo.title%",
        "category": "dsh-tui",
        "icon": "$(undo)"
      },
      {
        "command": "dsh-tui-vscode.editShowDiff",
        "title": "%command.dsh-tui-vscode.editShowDiff.title%",
        "category": "dsh-tui",
        "icon": "$(diff)"
      },
      {
        "command": "dsh-tui-vscode.editKeepAll",
        "title": "%command.dsh-tui-vscode.editKeepAll.title%",
        "category": "dsh-tui",
        "icon": "$(check-all)"
      },
      {
        "command": "dsh-tui-vscode.editUndoAll",
        "title": "%command.dsh-tui-vscode.editUndoAll.title%",
        "category": "dsh-tui",
        "icon": "$(discard)"
      },
      {
        "command": "dsh-tui-vscode.editNextHunk",
        "title": "%command.dsh-tui-vscode.editNextHunk.title%",
        "category": "dsh-tui",
        "icon": "$(chevron-down)"
      },
      {
        "command": "dsh-tui-vscode.editPrevHunk",
        "title": "%command.dsh-tui-vscode.editPrevHunk.title%",
        "category": "dsh-tui",
        "icon": "$(chevron-up)"
      },
      {
        "command": "dsh-tui-vscode.editKeepLine",
        "title": "%command.dsh-tui-vscode.editKeepLine.title%",
        "category": "dsh-tui"
      },
      {
        "command": "dsh-tui-vscode.editUndoLine",
        "title": "%command.dsh-tui-vscode.editUndoLine.title%",
        "category": "dsh-tui"
      }
    ],
    "keybindings": [
      {
        "command": "dsh-tui-vscode.insertAtMention",
        "key": "ctrl+alt+k",
        "mac": "cmd+alt+k",
        "when": "editorTextFocus"
      }
    ],
    "configuration": {
      "title": "dsh-tui (VS Code)",
      "properties": {
        "dsh-tui-vscode.command": {
          "type": "string",
          "default": "dsh-tui",
          "description": "%config.dsh-tui-vscode.command.description%"
        },
        "dsh-tui-vscode.extraArgs": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "default": [],
          "description": "%config.dsh-tui-vscode.extraArgs.description%"
        },
        "dsh-tui-vscode.terminalLocation": {
          "type": "string",
          "enum": [
            "editor",
            "active",
            "panel"
          ],
          "enumDescriptions": [
            "%config.dsh-tui-vscode.terminalLocation.enum.editor%",
            "%config.dsh-tui-vscode.terminalLocation.enum.active%",
            "%config.dsh-tui-vscode.terminalLocation.enum.panel%"
          ],
          "default": "editor",
          "description": "%config.dsh-tui-vscode.terminalLocation.description%"
        },
        "dsh-tui-vscode.lang": {
          "type": "string",
          "enum": [
            "",
            "zh",
            "en"
          ],
          "enumDescriptions": [
            "%config.dsh-tui-vscode.lang.enum.%",
            "%config.dsh-tui-vscode.lang.enum.zh%",
            "%config.dsh-tui-vscode.lang.enum.en%"
          ],
          "default": "",
          "description": "%config.dsh-tui-vscode.lang.description%"
        },
        "dsh-tui-vscode.imageProtocol": {
          "type": "string",
          "enum": [
            "auto",
            "sixel",
            "none"
          ],
          "enumDescriptions": [
            "%config.dsh-tui-vscode.imageProtocol.enum.auto%",
            "%config.dsh-tui-vscode.imageProtocol.enum.sixel%",
            "%config.dsh-tui-vscode.imageProtocol.enum.none%"
          ],
          "default": "sixel",
          "description": "%config.dsh-tui-vscode.imageProtocol.description%"
        },
        "dsh-tui-vscode.injectEditor": {
          "type": "boolean",
          "default": true,
          "description": "%config.dsh-tui-vscode.injectEditor.description%"
        },
        "dsh-tui-vscode.editorCommand": {
          "type": "string",
          "default": "code -w",
          "description": "%config.dsh-tui-vscode.editorCommand.description%"
        },
        "dsh-tui-vscode.dshHome": {
          "type": "string",
          "default": "",
          "description": "%config.dsh-tui-vscode.dshHome.description%"
        },
        "dsh-tui-vscode.autoInsertMention": {
          "type": "boolean",
          "default": true,
          "markdownDescription": "%config.dsh-tui-vscode.autoInsertMention.description%"
        },
        "dsh-tui-vscode.editReview.enabled": {
          "type": "boolean",
          "default": false,
          "description": "%config.dsh-tui-vscode.editReview.enabled.description%"
        },
        "dsh-tui-vscode.editReview.exclude": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "default": [
            "**/node_modules/**",
            "**/.git/**",
            "**/.svn/**",
            "**/.hg/**",
            "**/dist/**",
            "**/build/**",
            "**/__pycache__/**",
            "**/.vscode/**"
          ],
          "description": "%config.dsh-tui-vscode.editReview.exclude.description%"
        },
        "dsh-tui-vscode.editReview.diffView": {
          "type": "string",
          "enum": [
            "inline",
            "sideBySide",
            "auto"
          ],
          "enumDescriptions": [
            "%config.dsh-tui-vscode.editReview.diffView.enum.inline%",
            "%config.dsh-tui-vscode.editReview.diffView.enum.sideBySide%",
            "%config.dsh-tui-vscode.editReview.diffView.enum.auto%"
          ],
          "default": "inline",
          "description": "%config.dsh-tui-vscode.editReview.diffView.description%"
        }
      }
    }
  },
  "scripts": {
    "compile": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "npm run compile && node --test out/test/session.test.js out/test/sessions.test.js out/test/at-mention.test.js out/test/auto-mention.test.js out/test/ide-server.test.js out/test/session-watchers.test.js out/test/relative-time.test.js out/test/edit-review-core.test.js out/test/precise-review-core.test.js out/test/edit-ledger-store.test.js out/test/safe-path.test.js out/test/review-text.test.js out/test/edit-review-display.test.js out/test/edit-review-integration.test.js out/test/edit-review-regressions.test.js out/test/review-safety.test.js",
    "test:e2e": "npm run compile && tsc -p tsconfig.test.json && node out-test/test-suite/run-tests.js",
    "test:review:host": "npm run compile && node scripts/run-review-host.cjs",
    "test:review:ui": "npm run compile && node scripts/run-review-ui-host.cjs",
    "package": "npm run compile && vsce package",
    "install:local": "npm run package && node scripts/install-local.mjs"
  },
  "dependencies": {
    "@bokuweb/zstd-wasm": "^0.0.27",
    "ws": "^8.21.3"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "@types/vscode": "^1.90.0",
    "@types/ws": "^8.18.1",
    "@vscode/test-electron": "^2.4.1",
    "@vscode/vsce": "^3.9.2",
    "typescript": "^5.6.0"
  },
  "icon": "media/icon.png",
  "galleryBanner": {
    "color": "#1e1e1e",
    "theme": "dark"
  }
}
